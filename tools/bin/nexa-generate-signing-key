#!/bin/sh
set -eu
NEXA_TOOLS_ROOT=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
. "$NEXA_TOOLS_ROOT/lib/nexa-contributors.sh"
selected=${1-}; [ -n "$selected" ] || { echo "ERROR: contributor is required" >&2; exit 1; }
record=$(nexa_record "$selected") || { echo "ERROR: unknown contributor" >&2; exit 1; }
IFS='|' read -r github name email private_config public_config <<EOF
$record
EOF
private=$(nexa_expand_home "$private_config"); public=$(nexa_expand_home "$public_config")
[ ! -e "$private" ] && [ ! -e "$public" ] || { echo "ERROR: target key path already exists; refusing overwrite" >&2; exit 1; }
mkdir -p "$HOME/.ssh"; chmod 700 "$HOME/.ssh"
ssh-keygen -t ed25519 -C "$email" -f "$private"
chmod 600 "$private"; chmod 644 "$public"
key_type=$(awk 'NF >= 2 { print $1; exit }' "$public"); key_blob=$(awk 'NF >= 2 { print $2; exit }' "$public")
[ "$key_type" = ssh-ed25519 ] && [ -n "$key_blob" ] || { echo "ERROR: generated public key failed validation" >&2; exit 1; }
echo "PUBLIC KEY PATH: $public"
printf 'FINGERPRINT: '; ssh-keygen -lf "$public" | awk 'NR == 1 { print $2 }'
echo "PUBLIC KEY:"
cat "$public"
